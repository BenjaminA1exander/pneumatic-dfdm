 # ==========================================================================
+# Convergence bookkeeping (host side, does not interfere with the solves)
+# ==========================================================================
+
+_CONVERGENCE_STATS = {
+    "forward fixed point": {"solves": 0, "failed": 0, "worst": 0.0,
+                            "tol": None, "first_fail": None, "last_fail": None},
+    "adjoint linear solve": {"solves": 0, "failed": 0, "worst": 0.0,
+                             "tol": None, "first_fail": None, "last_fail": None},
+}
+
+
+def _record_convergence(kind, residual, tol):
+    """
+    Host callback: tally one solve and remember failures for the exit summary.
+    """
+    stats = _CONVERGENCE_STATS[kind]
+    residual = float(residual)
+    tol = float(tol)
+    stats["solves"] += 1
+    stats["tol"] = tol
+    # `not (residual <= tol)` so that a NaN residual counts as a failure too
+    if not (residual <= tol):
+        stats["failed"] += 1
+        if stats["first_fail"] is None:
+            stats["first_fail"] = stats["solves"]
+        stats["last_fail"] = stats["solves"]
+        if residual > stats["worst"]:
+            stats["worst"] = residual
+
+
+def convergence_summary():
+    """
+    Print a summary of the solves that exited without converging. Silent if all converged.
+    """
+    for kind, s in _CONVERGENCE_STATS.items():
+        if s["failed"]:
+            print(f"[jax_fdm] WARNING: {kind} did NOT converge in {s['failed']} of "
+                  f"{s['solves']} solves (worst residual {s['worst']:.3e} vs tolerance "
+                  f"{s['tol']:.1e}; failures between solve #{s['first_fail']} and "
+                  f"#{s['last_fail']})", flush=True)
+
+
+def convergence_reset():
+    """
+    Reset the convergence tallies (e.g. between optimisation stages).
+    """
+    for s in _CONVERGENCE_STATS.values():
+        s.update(solves=0, failed=0, worst=0.0, tol=None, first_fail=None, last_fail=None)
+
+
+atexit.register(convergence_summary)
+
+
